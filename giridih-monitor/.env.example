# ---------------------------------------------------------------------------
# Giridih AC-32 Election Monitor - environment template
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_DB=giridih
POSTGRES_USER=giridih
POSTGRES_PASSWORD=change-me-strong
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://giridih:change-me-strong@db:5432/giridih
# Read-only role used by the chatbot's run_sql tool (LLD 8.2)
READONLY_DB_URL=postgresql://giridih_ro:change-me-ro@db:5432/giridih
READONLY_DB_PASSWORD=change-me-ro

# --- API / auth -----------------------------------------------------------
JWT_SECRET=change-me-64-random-hex
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
API_CORS_ORIGINS=http://localhost:5173,https://giridih.example.org
# 'otp'  -> phone OTP via SMS provider below
# 'password' -> admin-issued passwords, no SMS cost (LLD 9)
AUTH_MODE=password
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
# NOTE vs LLD 8.3: the canonical Haiku 4.5 id has no date suffix, and Sonnet 5
# REJECTS the `temperature` parameter with a 400 - answer depth is controlled by
# ANALYSIS_EFFORT below instead of the LLD's "temperature 0".
MODEL_ROUTER=claude-haiku-4-5
MODEL_LOOKUP=claude-haiku-4-5
MODEL_ANALYSIS=claude-sonnet-5
MODEL_LABEL=claude-haiku-4-5
# low | medium | high | xhigh | max  (Sonnet 5 only; low keeps the bill down)
ANALYSIS_EFFORT=low

# Budgets (LLD 8.4)
LLM_MONTHLY_CAP_USD=120
LLM_DEGRADE_AT_PCT=80
DEFAULT_DAILY_TOKEN_BUDGET=150000
BLOCK_ROLE_DAILY_TOKEN_BUDGET=60000

# Price table (USD per million tokens) - re-check platform.claude.com/docs
PRICE_HAIKU_IN=1.00
PRICE_HAIKU_OUT=5.00
PRICE_SONNET_IN=2.00
PRICE_SONNET_OUT=10.00
CACHE_READ_MULTIPLIER=0.10
BATCH_DISCOUNT=0.50

# --- Embeddings -----------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_DEVICE=cpu
HF_HOME=/models

# --- Ingestion ------------------------------------------------------------
RAW_DIR=/data/raw
OCR_DIR=/data/ocr
BACKUP_DIR=/data/backups
# Compliance switch (LLD 12): delete raw roll PDFs after parsing
RETAIN_RAW_ROLLS=false
OCR_MIN_CONFIDENCE=70
PDF_TEXT_MIN_CHARS=40
TESSERACT_LANGS=hin+eng
NOMINATIM_USER_AGENT=giridih-monitor/1.0 (contact@example.org)
NOMINATIM_RPS=1

# Source portals (verify before first run)
CEO_JHARKHAND_BASE=https://ceo.jharkhand.gov.in
SEC_JHARKHAND_BASE=https://jharkhandsec.gov.in

# --- News crawler ---------------------------------------------------------
NEWS_USER_AGENT=giridih-monitor/1.0 (+contact@example.org)
NEWS_CRAWL_TIMEOUT=20
NEWS_MAX_ITEMS_PER_RUN=300

# --- Ops ------------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
PROMPT_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=14
