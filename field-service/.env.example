# Copy to .env and fill in. The app refuses to start while any value below is a placeholder.

# PostgreSQL. `python -m scripts.dev_stack up` starts an embedded server and writes this line for you.
DATABASE_URL=postgresql://change-me

# Telegram bot token from @BotFather (format 123456789:AA...). Use a test bot locally.
TELEGRAM_BOT_TOKEN=change-me

# Bot username without the @, used to build https://t.me/<username>?start=<token> links.
TELEGRAM_BOT_USERNAME=change-me

# Secret Telegram sends in X-Telegram-Bot-Api-Secret-Token on webhook calls.
# At least 32 characters from A-Z a-z 0-9 _ -. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=change-me

# Signing secret for bearer tokens (the stub core adapter verifies HS256 JWTs with it). At least 32 characters.
JWT_SECRET=change-me

# Which core adapter to use. Only `stub` exists in this repo.
CORE_ADAPTER=stub

# Optional ledger limits (LLD §4.5). Leave unset for the defaults shown.
# LEDGER_LARGE_ENTRY=25000
# LEDGER_BACKDATED_DAYS=7
# LEDGER_UNDO_MINUTES=10
# LEDGER_CONFIRM_AMOUNT_ABOVE=1000000
# EXPENSE_SESSION_MINUTES=15
# LEDGER_TAIL_THRESHOLD=2000
# LEDGER_ACK_REMIND_HOURS=24
# LEDGER_ACK_FLAG_HOURS=48

# Private media store (local disk). Must be outside the repo and not world-readable (preflight checks).
# Default: %LOCALAPPDATA%\pulse\media on Windows, ~/.local/share/pulse/media elsewhere. Never served publicly.
# MEDIA_DIR=
# Ground reports (LLD §4.5). TG_MAX_DOWNLOAD_BYTES is the Bot API getFile limit (20 MB).
# REPORT_JOIN_WINDOW_SECONDS=180
# REPORT_AUTOFILE_MINUTES=10
# REPORT_ADD_MORE_MINUTES=10
# REPORT_MAX_PHOTOS=10
# REPORT_MAX_VOICE_SECONDS=300
# TG_MAX_DOWNLOAD_BYTES=20971520

# How the bot receives updates: polling (local) or webhook (then WEBHOOK_URL, https only). Checked by preflight.
# BOT_MODE=polling
# WEBHOOK_URL=https://example.org/telegram/webhook
# PIN required in the bot for an expense or advance at or above this amount.
# LEDGER_PIN_LIMIT=50000
# bcrypt cost for PINs.
# BCRYPT_ROUNDS=12
# Retention: media kept this many days (unset = for ever); voided-entry retention is stored but not acted on yet.
# MEDIA_RETENTION_DAYS=
# VOID_RETENTION_DAYS=
# Delete the bot's own money cards after this many hours (must be under 48).
# CHAT_CLEANUP_HOURS=24
# Impact follow-up: ask "काम पूरा हुआ?" this many days after an ASSIST or WORKS expense.
# FOLLOWUP_DAYS=14
# Speech-to-text engine: a module in pulse/asr. none = voice notes stay audio-only (default);
# fake is for tests only. 16 kHz mono conversion uses ffmpeg when it is on PATH.
# ASR_ENGINE=none

# Map tiles for the Reports map (same tile server as the core app). Optional; default OpenStreetMap.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Development and tests only: never set these in production ---
# DEMO_MODE is set by `python -m scripts.demo` itself; do not put it here.
# Run the adapter conformance tests against another CoreAdapter (docs/MERGE.md §1):
# PULSE_CONFORMANCE_TARGET=package.module:factory
# Web tooling (web/): API target for the Vite dev server, base URL for the Playwright browser tests.
# PULSE_API=http://127.0.0.1:8787
# EM_BASE_URL=http://127.0.0.1:8787

# Real core adapter (production). Read-only access to the core database.
# CORE_ADAPTER=core
# CORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# CORE_JWT_SECRET=<the core's own JWT_SECRET; must differ from JWT_SECRET above>
