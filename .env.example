# ---------------------------------------------------------------------------
# Giridih AC-32 Election Monitor - environment template
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_DB=giridih
POSTGRES_USER=giridih
POSTGRES_PASSWORD=change-me-strong
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://giridih:change-me-strong@db:5432/giridih
# Read-only role used by the chatbot's run_sql tool (LLD 8.2)
READONLY_DB_URL=postgresql://giridih_ro:change-me-ro@db:5432/giridih
READONLY_DB_PASSWORD=change-me-ro

# --- API / auth -----------------------------------------------------------
JWT_SECRET=change-me-64-random-hex
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
API_CORS_ORIGINS=http://localhost:5173,https://giridih.example.org
# 'otp'  -> phone OTP via SMS provider below
# 'password' -> admin-issued passwords, no SMS cost (LLD 9)
AUTH_MODE=password
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
# NOTE vs LLD 8.3: the canonical Haiku 4.5 id has no date suffix, and Sonnet 5
# REJECTS the `temperature` parameter with a 400 - answer depth is controlled by
# ANALYSIS_EFFORT below instead of the LLD's "temperature 0".
MODEL_ROUTER=claude-haiku-4-5
MODEL_LOOKUP=claude-haiku-4-5
MODEL_ANALYSIS=claude-sonnet-5
MODEL_LABEL=claude-haiku-4-5
# low | medium | high | xhigh | max  (Sonnet 5 only; low keeps the bill down)
ANALYSIS_EFFORT=low

# Budgets (LLD 8.4)
LLM_MONTHLY_CAP_USD=120
LLM_DEGRADE_AT_PCT=80
DEFAULT_DAILY_TOKEN_BUDGET=150000
BLOCK_ROLE_DAILY_TOKEN_BUDGET=60000

# Price table (USD per million tokens) - re-check platform.claude.com/docs
PRICE_HAIKU_IN=1.00
PRICE_HAIKU_OUT=5.00
PRICE_SONNET_IN=2.00
PRICE_SONNET_OUT=10.00
CACHE_READ_MULTIPLIER=0.10
BATCH_DISCOUNT=0.50

# --- Feature flags --------------------------------------------------------
# The assistant is parked. With this false the API neither imports the chatbot
# package nor mounts /chat, so sqlglot and anthropic need not be installed, and
# the frontend hides the panel because /config reports chat_enabled=false.
CHAT_ENABLED=false

# --- Embeddings -----------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_DEVICE=cpu
HF_HOME=/models

# --- Ingestion ------------------------------------------------------------
RAW_DIR=/data/raw
OCR_DIR=/data/ocr
BACKUP_DIR=/data/backups
# Compliance switch (LLD 12): keep the raw roll PDF after parsing.
# Default is now TRUE. The audit (C13) found the old default deleted the only
# auditable original while the extracted page text - names, EPIC numbers,
# addresses - stayed on disk in ocr/. Keeping the PDF (0600, worker-only) and
# never caching its text is the right way round.
RETAIN_RAW_ROLLS=true

# --- Document storage (common/storage.py) --------------------------------
# Default backend for source documents: local | s3
STORAGE_BACKEND=local
# Per-kind overrides, one variable per source_doc.kind. Published documents can
# live in object storage; a shared bucket lets an analyst on a laptop re-parse a
# Form 20 against a remote database without downloading the PDFs by hand.
STORAGE_BACKEND_FORM20=s3
STORAGE_BACKEND_PS_LIST=s3
STORAGE_BACKEND_SEC_RESULT=s3
# Electoral rolls stay on this host. These two are refused a remote backend
# whatever you set here - see common/storage.assert_local_only - and are listed
# only so the intent is visible in the file.
STORAGE_BACKEND_ROLL_MOTHER=local
STORAGE_BACKEND_ROLL_SUPPLEMENT=local
# S3-compatible object storage. Leave S3_ENDPOINT empty for AWS S3; set it for
# Backblaze B2, MinIO or Wasabi. Unused when STORAGE_BACKEND=local and no kind
# overrides to s3.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PREFIX=raw
OCR_MIN_CONFIDENCE=70
PDF_TEXT_MIN_CHARS=40
TESSERACT_LANGS=hin+eng
NOMINATIM_USER_AGENT=giridih-monitor/1.0 (contact@example.org)
NOMINATIM_RPS=1

# Source portals (verify before first run)
CEO_JHARKHAND_BASE=https://ceo.jharkhand.gov.in
SEC_JHARKHAND_BASE=https://jharkhandsec.gov.in

# --- News crawler ---------------------------------------------------------
NEWS_USER_AGENT=giridih-monitor/1.0 (+contact@example.org)
NEWS_CRAWL_TIMEOUT=20
NEWS_MAX_ITEMS_PER_RUN=300

# --- Ops ------------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
PROMPT_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Base map tiles (frontend, build-time)
# ---------------------------------------------------------------------------
# The map shipped with a CARTO URL hardcoded in the page. That URL still works
# as a request; what changed is CARTO's side of it - their keyless endpoint now
# returns watermark tiles reading "API key required". Nothing in this repository
# broke, and reacting to it took a code change. Now it takes an edit here.
# See DECISIONS.md D-007.
#
# All four are optional. Left unset, the map uses OpenStreetMap's standard
# tiles, which need no key.
#
# VITE_TILE_URL may contain a key as a query parameter, so moving to a keyed
# provider later is only a change to this file. Two examples, for later:
#   VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_TILE_URL=https://tile.thunderforest.com/atlas/{z}/{x}/{y}.png?apikey=YOUR_KEY
#
# If you set VITE_TILE_URL, set VITE_TILE_ATTRIBUTION too: the OpenStreetMap
# credit is only correct for OpenStreetMap tiles, and crediting the wrong
# people is worse than crediting nobody.
#VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
#VITE_TILE_MAX_ZOOM=19
# Only used when the URL contains the {s} subdomain placeholder. Modern
# providers do not use it; passing it otherwise makes Leaflet warn per tile.
#VITE_TILE_SUBDOMAINS=abc
