# ---------------------------------------------------------------------------
# Supabase-hosted database (election_monitor project)
# Copy to .env at repo root and fill in secrets. NEVER commit .env.
# ---------------------------------------------------------------------------
#
# Session pooler (IPv4, port 5432) — required for psycopg from most networks.
# Dashboard: Project Settings → Database → Connection string → Session pooler
#
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
DATABASE_URL=postgresql://postgres.yuafpimhyccceuncijto:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
READONLY_DB_URL=postgresql://giridih_ro:YOUR_READONLY_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
READONLY_DB_PASSWORD=YOUR_READONLY_PASSWORD

# --- API / auth -----------------------------------------------------------
JWT_SECRET=generate-64-hex-chars-minimum-not-a-placeholder-from-example
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
AUTH_MODE=password
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single production login (required for API startup)
APP_USERNAME=admin
APP_PASSWORD=change-me-strong-production-password

CHAT_ENABLED=false
STORAGE_BACKEND=local
RAW_DIR=./raw
OCR_DIR=./ocr
BACKUP_DIR=./backups
LOG_LEVEL=INFO
