FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

WORKDIR /app

# poppler-utils -> pdftoppm (LLD 4.1); tesseract with Hindi + English traineddata
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 poppler-utils tesseract-ocr tesseract-ocr-hin tesseract-ocr-eng \
        postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY common ./common
COPY ingest ./ingest
COPY news ./news
COPY analytics ./analytics
COPY worker ./worker
COPY db ./db

RUN useradd --create-home --uid 10002 worker && mkdir -p /models /data && chown -R worker /app /models /data
USER worker

CMD ["python", "-m", "worker.scheduler"]
