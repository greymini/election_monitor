FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

WORKDIR /app

# poppler-utils -> pdftoppm (LLD 4.1); tesseract with Hindi + English traineddata
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 poppler-utils tesseract-ocr tesseract-ocr-hin tesseract-ocr-eng \
        postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY common ./common
COPY ingest ./ingest
COPY news ./news
# news/label_batch.py and label_collect.py use chatbot.llm and chatbot.budget;
# without this both labelling jobs died with ModuleNotFoundError.
COPY chatbot ./chatbot
COPY analytics ./analytics
COPY worker ./worker
COPY db ./db

# The volume mount points must exist, owned by the worker, before the volumes
# are attached: otherwise Docker creates them as root and every write fails (A3).
RUN useradd --create-home --uid 10002 worker \
    && mkdir -p /models /data/raw /data/ocr /data/backups \
    && chown -R worker /app /models /data
USER worker

CMD ["python", "-m", "worker.scheduler"]
