FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY common ./common
COPY api ./api
COPY chatbot ./chatbot
COPY analytics ./analytics
# The first admin is created from the API image (it has bcrypt and jose):
#   docker compose run --rm api python -m scripts.create_admin ...
# api.main bootstraps the single login (APP_USERNAME / APP_PASSWORD) at startup.
COPY scripts ./scripts
COPY ingest ./ingest
# /news and /news/summary use news.crawl_rss (place terms) and news.embed.
COPY news ./news
# /boundaries serves source warnings and unseeded blocks from the built file.
COPY db/seed/geo ./db/seed/geo

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

EXPOSE 8000
# PORT is set by hosts such as Railway; 8000 otherwise.
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2"]
