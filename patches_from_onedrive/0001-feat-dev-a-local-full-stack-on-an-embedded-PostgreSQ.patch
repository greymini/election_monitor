+-- ---------------------------------------------------------------------------
+
+DO $$
+DECLARE
+    point_type TEXT;
+    poly_type  TEXT;
+BEGIN
+    IF app_has_postgis() THEN
+        point_type := 'geometry(Point, 4326)';
+        poly_type  := 'geometry(MultiPolygon, 4326)';
+    ELSE
+        point_type := 'point';
+        poly_type  := 'polygon';
+    END IF;
+
+    EXECUTE format('ALTER TABLE area  ADD COLUMN geom %s', poly_type);
+    EXECUTE format('ALTER TABLE booth ADD COLUMN geom %s', point_type);
